<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-accounts-table" author="system">
        <createTable tableName="accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="operator_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="available_amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="unchecked_available_amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="is_used" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addForeignKeyConstraint
                baseTableName="accounts"
                baseColumnNames="operator_id"
                constraintName="fk_accounts_operator"
                referencedTableName="operators"
                referencedColumnNames="operator_id"/>
        
        <createIndex indexName="idx_accounts_operator_id" tableName="accounts">
            <column name="operator_id"/>
        </createIndex>
        
        <createIndex indexName="idx_accounts_is_active" tableName="accounts">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
